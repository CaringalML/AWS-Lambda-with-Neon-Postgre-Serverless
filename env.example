# GitHub Actions Secrets
# Go to: GitHub repo → Settings → Secrets and variables → Actions → New repository secret

# AWS credentials (IAM user with Lambda, API Gateway, S3, SSM, CloudFront, ACM, SNS, Batch, DynamoDB permissions)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Neon PostgreSQL connection string (used by CI migrations and Terraform)
DATABASE_URL=postgresql://<user>:<password>@<host>.ap-southeast-2.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

# Resend API key for transactional email (archive/restore notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Single admin credentials — seeded into SSM on first deploy, never overwritten after that
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=YourStr0ngPassword1

# Docker Hub credentials (for pushing the Batch worker image)
DOCKERHUB_USERNAME=yourdockerhubusername
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
